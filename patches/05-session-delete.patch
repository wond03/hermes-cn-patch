+def _gateway_api_settings():
+    """从 ~/.hermes/.env 读 api_server 的端口和 key；没开就返回 None。"""
+    import os as _os
+
+    try:
+        env_path = Path(_os.environ.get('HERMES_HOME') or Path.home() / '.hermes') / '.env'
+        values = {}
+        for line in env_path.read_text(encoding='utf-8').splitlines():
+            line = line.strip()
+            if not line or line.startswith('#') or '=' not in line:
+                continue
+            key, _, val = line.partition('=')
+            values[key.strip()] = val.strip().strip('"').strip("'")
+        if str(values.get('API_SERVER_ENABLED', '')).lower() in {'0', 'false', 'no', 'off'}:
+            return None
+        port = values.get('API_SERVER_PORT') or '8642'
+        key = values.get('API_SERVER_KEY') or ''
+        if not key:
+            return None
+        return f'http://127.0.0.1:{port}', key
+    except Exception:  # noqa: BLE001 - 没配置就退回原来的 409
+        return None
+
+
+def _delete_sessions_via_gateway(profile, ids):
+    """让锁持有者（网关）自己删：返回 (deleted, skipped_active) 或 None（网关不可用）。"""
+    import urllib.error as _uerr  # noqa: F401 - 保留以便定位鉴权失败
+    import urllib.request as _ureq
+
+    settings = _gateway_api_settings()
+    if not settings:
+        return None
+    base, key = settings
+    payload = json.dumps({'ids': ids, 'profile': profile or 'default'}).encode('utf-8')
+    req = _ureq.Request(
+        base + '/api/sessions/bulk-delete',
+        data=payload,
+        method='POST',
+        headers={
+            'Content-Type': 'application/json',
+            'Authorization': f'Bearer {key}',
+            'X-Hermes-Profile': profile or 'default',
+        },
+    )
+    try:
+        with _ureq.urlopen(req, timeout=30) as resp:
+            data = json.loads(resp.read().decode('utf-8'))
+        return int(data.get('deleted') or 0), list(data.get('skipped_active') or [])
+    except Exception as exc:  # noqa: BLE001 - 超时/404 都说明这条路不通
+        _log.debug('bulk delete via gateway failed: %s', exc)
+        return None
+
+
