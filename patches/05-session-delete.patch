+# 维护锁被本机网关占用时，短暂停网关再重试。同一时刻只允许一个请求做这件事，
+# 否则两个删除请求会互相把对方的网关停掉/拉起。
+_MAINTENANCE_PAUSE_LOCK = __import__('threading').Lock()
+
+
+def _gateway_active_agents(home) -> int:
+    """网关当前正在跑的 turn 数；>0 时不能抢锁，否则会打断用户正在进行的对话。"""
+    import json as _json
+
+    try:
+        state = _json.loads((Path(home) / 'gateway_state.json').read_text(encoding='utf-8'))
+        return int(state.get('active_agents') or 0)
+    except Exception:  # noqa: BLE001 - 状态文件缺失/损坏都当作空闲
+        return 0
+
+
+def _gateway_bin() -> str:
+    import os as _os
+    import shutil as _shutil
+
+    override = _os.environ.get('HERMES_BIN')
+    if override:
+        return override
+    return _shutil.which('hermes') or '/root/.local/bin/hermes'
+
+
+def _run_hermes_gateway(verb: str, home, timeout: int) -> bool:
+    import os as _os
+    import subprocess as _sp
+
+    env = dict(_os.environ)
+    env['HERMES_HOME'] = str(home)
+    env.setdefault('HOME', str(Path(home).parent))
+    try:
+        done = _sp.run(
+            [_gateway_bin(), 'gateway', verb],
+            env=env,
+            stdin=_sp.DEVNULL,
+            capture_output=True,
+            timeout=timeout,
+        )
+        return done.returncode == 0
+    except Exception:  # noqa: BLE001 - 起停失败就走原来的 409 路径
+        return False
+
+
