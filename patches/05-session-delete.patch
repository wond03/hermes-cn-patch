+    @_require_auth
+    async def _handle_bulk_delete_sessions(self, request: web.Request) -> web.Response:
+        """POST /api/sessions/bulk-delete — 本机面板借网关的锁执行批量删除。
+
+        面板是独立进程，删除要拿会话库的独占维护锁，而网关一直持有它，于是面板只能
+        409。这里让锁的持有者自己删：与面板的删除语义完全一致（压缩链整条删、跳过
+        正在跑的 turn）。
+        """
+        try:
+            body = await request.json()
+        except Exception:  # noqa: BLE001 - 任何解析失败都回 400，不抛栈
+            return _error_response("Invalid JSON body", 400, code="invalid_body")
+        raw_ids = body.get("ids") if isinstance(body, dict) else None
+        if not isinstance(raw_ids, list) or not all(isinstance(i, str) and i for i in raw_ids):
+            return _error_response("'ids' must be a list of non-empty strings", 400, code="invalid_ids")
+        if len(raw_ids) > 500:
+            return _error_response("ids must contain at most 500 entries", 400, code="too_many_ids")
+        ids = list(dict.fromkeys(raw_ids))
+        db = await self._ensure_session_db_async()
+        if db is None:
+            return self._session_db_unavailable()
+        sessions_dir = None
+        try:
+            from hermes_constants import get_hermes_home
+            sessions_dir = Path(get_hermes_home()) / "sessions"
+        except Exception:  # noqa: BLE001 - 目录不可得时只是少清理 dump 文件
+            logger.debug("sessions dir unavailable for bulk delete", exc_info=True)
+        skipped: list[str] = []
+        try:
+            deleted = await asyncio.to_thread(
+                db.delete_sessions, ids, sessions_dir=sessions_dir,
+                exclude_active_write_guards=True, skipped_ids=skipped,
+                include_compression_chain=True)
+        except Exception as exc:  # noqa: BLE001 - 锁/库异常统一回 409/500
+            return _error_response(str(exc), 409, code="session_delete_failed")
+        runner = self.gateway_runner or request.app.get("gateway_runner")
+        store = getattr(runner, "session_store", None)
+        if store is not None and deleted:
+            for sid in ids:
+                try:
+                    await asyncio.to_thread(store.remove_by_session_id, sid)
+                except Exception:  # noqa: BLE001 - 路由清理失败不影响删除结果
+                    logger.debug("routing cleanup failed for %s", sid, exc_info=True)
+        return web.json_response({"ok": True, "deleted": deleted, "skipped_active": skipped})
+
