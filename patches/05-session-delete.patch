+def _with_session_maintenance_after_gateway_pause(profile, operation, *args):
+    """最后手段：网关 API 不可用（没开 api_server / 老版本）时，停网关→执行→拉起。
+
+    只在调用方已经确认没有活跃 turn 时使用；整个过程持 _MAINTENANCE_PAUSE_LOCK，
+    避免两个删除请求互相拆台。
+    """
+    from fastapi import HTTPException
+    from gateway.runtime_ownership import OwnershipConflict, exclusive_maintenance
+    from hermes_cli.web_server_cron import _cron_profile_home
+    from hermes_state import _default_db_path
+
+    home = Path(_cron_profile_home(profile)[1]) if profile else Path(_default_db_path()).parent
+
+    def _attempt():
+        with exclusive_maintenance([home]):
+            return operation(*args)
+
+    if _gateway_active_agents(home) > 0:
+        raise HTTPException(
+            status_code=409,
+            detail='网关正在跑一个对话，等它结束再删（或先发 /stop 中断）。',
+        )
+    with _MAINTENANCE_PAUSE_LOCK:
+        if not _run_hermes_gateway('stop', home, 45):
+            raise HTTPException(status_code=409, detail='网关没能停下来，稍后重试。')
+        try:
+            return _attempt()
+        except OwnershipConflict as exc:
+            raise HTTPException(status_code=409, detail=str(exc)) from exc
+        finally:
+            _run_hermes_gateway('ensure', home, 60)
+
