diff --git a/web/src/i18n/context.tsx b/web/src/i18n/context.tsx
index e407988edf..4053fe209d 100644
--- a/web/src/i18n/context.tsx
+++ b/web/src/i18n/context.tsx
@@ -1,4 +1,5 @@
 import { applyDocumentLocale, LOCALE_ENDONYMS } from "@hermes/shared/i18n";
+import { api } from "@/lib/api";
 import { createContext, useContext, useState, useCallback, useEffect, type ReactNode } from "react";
 import type { Locale, Translations } from "./types";
 import { en } from "./en";
@@ -60,6 +61,25 @@ function getInitialLocale(): Locale {
   } catch {
     // SSR or privacy mode
   }
+  // Fall back to the browser's preferred languages before defaulting to English.
+  try {
+    const prefs = (navigator.languages && navigator.languages.length
+      ? Array.from(navigator.languages)
+      : [navigator.language]) as string[];
+    for (const raw of prefs) {
+      const tag = String(raw || "").toLowerCase();
+      if (!tag) continue;
+      if (tag === "zh" || tag.startsWith("zh-")) {
+        // 简繁分流：TW/HK/MO/Hant 走繁体，其余走简体
+        return /hant|tw|hk|mo/.test(tag) ? "zh-hant" : "zh";
+      }
+      if (isLocale(tag)) return tag;
+      const base = tag.split("-")[0];
+      if (isLocale(base)) return base;
+    }
+  } catch {
+    // no navigator
+  }
   return "en";
 }
 
@@ -87,6 +107,35 @@ export function I18nProvider({ children }: { children: ReactNode }) {
     }
   }, []);
 
+  // 浏览器没有显式选择过语言时，跟随服务端 display.language（config.yaml）
+  useEffect(() => {
+    let cancelled = false;
+    try {
+      if (localStorage.getItem(STORAGE_KEY)) return;
+    } catch {
+      return;
+    }
+    api
+      .getConfig()
+      .then((cfg) => {
+        const raw = String((cfg as Record<string, Record<string, unknown>>)?.display?.language ?? "")
+          .trim()
+          .toLowerCase()
+          .replace(/_/g, "-");
+        if (cancelled || !raw || raw === "auto") return;
+        const resolved = raw.startsWith("zh")
+          ? /hant|tw|hk|mo/.test(raw)
+            ? "zh-hant"
+            : "zh"
+          : raw;
+        if (isLocale(resolved)) setLocaleState(resolved);
+      })
+      .catch(() => {});
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
   useEffect(() => {
     applyDocumentLocale(locale);
   }, [locale]);
