+async function uploadChatFile(file: File): Promise<string> {
+  const listing = await api.listFiles();
+  const root = listing.path;
+  if (!root) throw new Error("找不到可写的文件根目录");
+  const dir = `${root.replace(/\/+$/, "")}/hermes-uploads`;
+  const safe = file.name.replace(/[^\w.\-]+/g, "_").slice(-80) || "upload";
+  const target = `${dir}/${Date.now()}_${safe}`;
+  try {
+    await api.createDirectory(dir);
+  } catch {
+    // 目录已存在
+  }
+  const out = await api.uploadFile(target, file, true);
+  return (out as { path?: string }).path || target;
+}
+
+function MobileChatComposer({
+  onSend,
