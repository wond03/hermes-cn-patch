+/* 窄屏防溢出 —— 配置页等长内容（点号分隔的配置键、路径、命令）没有断点，
+   在手机上会把整页撑出视口，导致必须左右拖动才能看全。以下规则只在
+   ≤768px 生效，桌面布局不受影响。 */
+@media (max-width: 768px) {
+  .font-mono,
+  code,
+  kbd,
+  pre,
+  samp {
+    overflow-wrap: anywhere;
+  }
+
+  /* 栅格/弹性子项默认 min-width:auto，长内容会把轨道顶宽 */
+  .grid > *,
+  .flex > * {
+    min-width: 0;
+  }
+
+  /* 控件不超出视口 */
+  input,
+  select,
+  textarea,
+  button {
+    max-width: 100%;
+  }
+
+  table {
+    max-width: 100%;
+  }
+
+  /* iOS 上聚焦字号 <16px 的输入框会强制放大页面 */
+  input,
+  textarea,
+  select {
+    font-size: 16px;
+  }
+
+  /* 终端：手势交给我们自己的 touch 滚动处理，并禁止页面橡皮筋，
+     否则拖动终端时外层页面会跟着弹，手感发飘 */
+  .xterm,
+  .xterm .xterm-screen,
+  .xterm .xterm-viewport {
+    touch-action: pan-y;
+    overscroll-behavior: contain;
+    -webkit-overflow-scrolling: touch;
+  }
+}
+
