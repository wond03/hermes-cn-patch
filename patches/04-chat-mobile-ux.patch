+    const files = Array.from(e.target.files ?? []);
+    e.target.value = "";
+    if (!files.length) return;
+    for (const f of files) {
+      // 后端 /api/files/upload-stream 上限 100MB，提前拦一下，省得白传
+      if (f.size > 100 * 1024 * 1024) {
+        setNotice(`跳过 ${f.name}：超过 100MB 上限`);
+        window.setTimeout(() => setNotice(null), 4000);
+        continue;
+      }
+      setNotice(`上传中：${f.name}（${(f.size / 1048576).toFixed(1)}MB）`);
+      try {
+        if (f.type.startsWith("image/")) {
+          const up = await uploadChatImage(f, profile);
+          onSend(`/image ${up.path}`);
+          window.setTimeout(() => onSend("\r"), 180);
+          setNotice(`已附加图片：${f.name}`);
