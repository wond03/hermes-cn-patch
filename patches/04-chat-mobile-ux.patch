+        <div className="pointer-events-none absolute bottom-full left-0 right-0 px-3 pb-1 text-center text-xs text-text-secondary">
+          {notice}
+        </div>
+      )}
+      <input
+        ref={fileRef}
+        type="file"
+        accept="image/*,video/*,audio/*,application/pdf,text/*,.md,.csv,.json,.yaml,.yml,.log,.py,.js,.ts,.tsx,.html,.css,.sh,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.tar,.gz,.7z,.epub"
+        multiple
+        className="hidden"
+        onChange={onFilePicked}
+      />
+      {/* 工具条放上面一行，输入框才能占满整个宽度（之前按钮挤得只剩 7 个字） */}
+      <div className="flex items-center gap-1">
+        <button
+          type="button"
+          onClick={pickImage}
+          aria-label="添加图片或文件"
+          title="添加图片或文件"
+          className="flex h-8 w-9 shrink-0 items-center justify-center rounded border border-border text-sm text-text-secondary active:bg-muted"
+        >
+          ＋
+        </button>
+        <button
+          type="button"
+          onClick={interrupt}
+          aria-label="中断当前任务"
+          title="中断当前任务（Ctrl+C）"
+          className="flex h-8 w-9 shrink-0 items-center justify-center rounded border border-border text-xs text-text-secondary active:bg-muted"
+        >
+          ■
+        </button>
+        <button
+          type="button"
+          onClick={recallPrev}
+          aria-label="上一条输入"
+          title="上一条输入"
+          className="flex h-8 w-9 shrink-0 items-center justify-center rounded border border-border text-xs text-text-secondary active:bg-muted"
+        >
+          ↑
+        </button>
+        <button
+          type="button"
+          onClick={() => {
+            window.location.assign("/files?path=/root/outputs");
+          }}
+          aria-label="打开产出目录"
+          title="打开产出目录"
+          className="h-8 shrink-0 rounded border border-border px-2 text-[11px] text-text-secondary active:bg-muted"
+        >
+          产出
+        </button>
+        <button
+          type="button"
+          onClick={async () => {
+            const ok = onCopyAll ? await onCopyAll() : false;
+            setNotice(ok ? "已复制整段对话" : "没有可复制的内容");
+            window.setTimeout(() => setNotice(null), 2500);
+          }}
+          aria-label="复制整段对话"
+          title="复制整段对话"
+          className="h-8 shrink-0 rounded border border-border px-2 text-[11px] text-text-secondary active:bg-muted"
+        >
+          复制
+        </button>
+      </div>
+      <div className="flex items-end gap-1.5 pb-0.5">
+        <textarea
+          ref={taRef}
+          value={value}
+          onChange={(e) => {
+            setValue(e.target.value);
+            autosize();
+          }}
+          onKeyDown={(e) => {
+            const composing = (e.nativeEvent as unknown as { isComposing?: boolean }).isComposing;
+            // 手机上回车 = 换行（输入法里换行是刚需），发送走按钮或 Ctrl/Cmd+Enter
+            if (e.key === "Enter" && (e.ctrlKey || e.metaKey) && !composing) {
+              e.preventDefault();
+              submit();
+              return;
+            }
+            if (e.key === "ArrowUp" && !value && !composing) {
+              e.preventDefault();
+              recallPrev();
+            }
+          }}
+          rows={1}
+          enterKeyHint="enter"
+          placeholder="输入消息，换行后点发送"
+          aria-label="消息输入框"
+          className="max-h-24 min-h-10 flex-1 resize-none rounded border border-border bg-background px-3 py-2 text-base text-foreground outline-none focus:border-midground"
+        />
+        <button
+          type="button"
+          onClick={submit}
+          disabled={!value.trim()}
+          className="flex h-10 shrink-0 items-center justify-center rounded border border-border px-4 text-sm hover:border-midground disabled:opacity-40"
+        >
+          发送
+        </button>
+      </div>
+    </div>
+  );
+}
